    {
      "id": 30,
      "type": "row",
      "title": "Latency Table",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 31,
      "type": "table",
      "title": "Latency Summary \u2014 All Topics",
      "description": "Latest latency percentiles for every tracked topic",
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "options": {
        "sortBy": [
          {
            "displayName": "p99 (ms)",
            "desc": true
          }
        ],
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "count"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "Value #A": "mean (ms)",
              "Value #B": "p50 (ms)",
              "Value #C": "p75 (ms)",
              "Value #D": "p90 (ms)",
              "Value #E": "p95 (ms)",
              "Value #F": "p99 (ms)",
              "Value #G": "max (ms)",
              "Value #H": "count"
            }
          }
        }
      ],
      "targets": [
        {
          "expr": "latency_mean_ms{topic=~\"$topic\", job=\"$app\"}",
          "instant": true,
          "legendFormat": "{{topic}}",
          "refId": "A"
        },
        {
          "expr": "latency_p50_ms{topic=~\"$topic\", job=\"$app\"}",
          "instant": true,
          "legendFormat": "{{topic}}",
          "refId": "B"
        },
        {
          "expr": "latency_p75_ms{topic=~\"$topic\", job=\"$app\"}",
          "instant": true,
          "legendFormat": "{{topic}}",
          "refId": "C"
        },
        {
          "expr": "latency_p90_ms{topic=~\"$topic\", job=\"$app\"}",
          "instant": true,
          "legendFormat": "{{topic}}",
          "refId": "D"
        },
        {
          "expr": "latency_p95_ms{topic=~\"$topic\", job=\"$app\"}",
          "instant": true,
          "legendFormat": "{{topic}}",
          "refId": "E"
        },
        {
          "expr": "latency_p99_ms{topic=~\"$topic\", job=\"$app\"}",
          "instant": true,
          "legendFormat": "{{topic}}",
          "refId": "F"
        },
        {
          "expr": "latency_max_ms{topic=~\"$topic\", job=\"$app\"}",
          "instant": true,
          "legendFormat": "{{topic}}",
          "refId": "G"
        },
        {
          "expr": "latency_count{topic=~\"$topic\", job=\"$app\"}",
          "instant": true,
          "legendFormat": "{{topic}}",
          "refId": "H"
        }
      ]
    }
  ]
