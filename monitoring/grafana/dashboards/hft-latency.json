        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineWidth": 2
          }
        }
      },
      "targets": [
        {
          "expr": "latency_mean_ms{topic=~\"$topic\", job=\"$app\"}",
          "legendFormat": "mean \u2014 {{topic}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 20,
      "type": "row",
      "title": "Latency by Stage",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Depth Latency by Stage (ms) \u2014 P90",
      "description": "toBrokerConnector / toAlgoConnector / toStrategy / toNow latencies for depth updates",
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      },
      "targets": [
        {
          "expr": "latency_p90_ms{topic=~\"depth\\..*\\.toBrokerConnector\", job=\"$app\"}",
          "legendFormat": "toBrokerConnector \u2014 {{topic}}",
          "refId": "A"
        },
        {
          "expr": "latency_p90_ms{topic=~\"depth\\..*\\.toAlgoConnector\", job=\"$app\"}",
          "legendFormat": "toAlgoConnector \u2014 {{topic}}",
          "refId": "B"
        },
        {
          "expr": "latency_p90_ms{topic=~\"depth\\..*\\.toStrategy\", job=\"$app\"}",
          "legendFormat": "toStrategy \u2014 {{topic}}",
          "refId": "C"
        },
        {
          "expr": "latency_p90_ms{topic=~\"depth\\..*\\.toNow\", job=\"$app\"}",
          "legendFormat": "toNow \u2014 {{topic}}",
          "refId": "D"
        }
      ]
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Order Request Latency by Stage (ms) \u2014 P90",
      "description": "Outbound: toAlgoConnector / toBrokerConnector / toNow for order requests",
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "fieldConfig": {
        "defaults": {
