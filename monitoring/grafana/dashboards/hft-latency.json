        },
        {
          "expr": "latency_${percentile}_ms{topic=~\"depth\\..*\\.toAlgoConnector\", job=\"$app\"}",
          "legendFormat": "toAlgoConnector \u2014 {{topic}}",
          "refId": "B"
        },
        {
          "expr": "latency_${percentile}_ms{topic=~\"depth\\..*\\.toStrategy\", job=\"$app\"}",
          "legendFormat": "toStrategy \u2014 {{topic}}",
          "refId": "C"
        },
        {
          "expr": "latency_${percentile}_ms{topic=~\"depth\\..*\\.toNow\", job=\"$app\"}",
          "legendFormat": "toNow \u2014 {{topic}}",
          "refId": "D"
        }
      ]
    },
    {
