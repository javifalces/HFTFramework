        {
          "expr": "latency_p90_ms{topic=~\"orderRequest\\..*\\.toBrokerConnector\", job=\"$app\"}",
          "legendFormat": "toBrokerConnector \u2014 {{topic}}",
          "refId": "B"
        },
        {
          "expr": "latency_p90_ms{topic=~\"orderRequest\\..*\\.toNow\", job=\"$app\"}",
