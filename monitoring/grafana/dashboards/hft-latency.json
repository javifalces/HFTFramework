    {
      "id": 30,
      "type": "row",
      "title": "Latency Table",
      "collapsed": false,
      "gridPos": {"x": 0, "y": 36, "w": 24, "h": 1}
    },
    {
      "id": 31,
      "type": "table",
      "title": "Latency Summary \u2014 By Prefix (aggregated TOTAL)",
      "description": "Latest aggregated percentiles per prefix type (depth / trade / executionReport / orderRequest)",
      "gridPos": {"x": 0, "y": 37, "w": 12, "h": 10},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "options": {
        "sortBy": [{"displayName": "p99 (ms)", "desc": true}],
        "footer": {"show": false}
      },
      "fieldConfig": {
        "defaults": {"unit": "ms"},
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "count"},
            "properties": [{"id": "unit", "value": "short"}]
          }
        ]
      },
      "transformations": [
        {"id": "merge", "options": {}},
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": ["prefix", "Value #A", "Value #B", "Value #C", "Value #D", "Value #E", "Value #F", "Value #G", "Value #H"]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "prefix":   "Prefix",
              "Value #A": "mean (ms)",
              "Value #B": "p50 (ms)",
              "Value #C": "p75 (ms)",
              "Value #D": "p90 (ms)",
              "Value #E": "p95 (ms)",
              "Value #F": "p99 (ms)",
              "Value #G": "max (ms)",
              "Value #H": "count"
            }
          }
        }
      ],
      "targets": [
        {
          "expr": "avg by (prefix) (label_replace(latency_mean_ms{topic=~\".*\\.TOTAL\", job=\"$app\"}, \"prefix\", \"$1\", \"topic\", \"([^.]+)\\..*\"))",
          "instant": true,
          "format": "table",
          "legendFormat": "__auto",
          "refId": "A"
        },
        {
          "expr": "avg by (prefix) (label_replace(latency_p50_ms{topic=~\".*\\.TOTAL\", job=\"$app\"}, \"prefix\", \"$1\", \"topic\", \"([^.]+)\\..*\"))",
          "instant": true,
          "format": "table",
          "legendFormat": "__auto",
          "refId": "B"
        },
        {
          "expr": "avg by (prefix) (label_replace(latency_p75_ms{topic=~\".*\\.TOTAL\", job=\"$app\"}, \"prefix\", \"$1\", \"topic\", \"([^.]+)\\..*\"))",
          "instant": true,
          "format": "table",
          "legendFormat": "__auto",
          "refId": "C"
        },
        {
          "expr": "avg by (prefix) (label_replace(latency_p90_ms{topic=~\".*\\.TOTAL\", job=\"$app\"}, \"prefix\", \"$1\", \"topic\", \"([^.]+)\\..*\"))",
          "instant": true,
          "format": "table",
          "legendFormat": "__auto",
          "refId": "D"
        },
        {
          "expr": "avg by (prefix) (label_replace(latency_p95_ms{topic=~\".*\\.TOTAL\", job=\"$app\"}, \"prefix\", \"$1\", \"topic\", \"([^.]+)\\..*\"))",
          "instant": true,
          "format": "table",
          "legendFormat": "__auto",
          "refId": "E"
        },
        {
          "expr": "avg by (prefix) (label_replace(latency_p99_ms{topic=~\".*\\.TOTAL\", job=\"$app\"}, \"prefix\", \"$1\", \"topic\", \"([^.]+)\\..*\"))",
          "instant": true,
          "format": "table",
          "legendFormat": "__auto",
          "refId": "F"
        },
        {
          "expr": "avg by (prefix) (label_replace(latency_max_ms{topic=~\".*\\.TOTAL\", job=\"$app\"}, \"prefix\", \"$1\", \"topic\", \"([^.]+)\\..*\"))",
          "instant": true,
          "format": "table",
          "legendFormat": "__auto",
          "refId": "G"
        },
        {
          "expr": "sum by (prefix) (label_replace(latency_count{topic=~\".*\\.TOTAL\", job=\"$app\"}, \"prefix\", \"$1\", \"topic\", \"([^.]+)\\..*\"))",
          "instant": true,
          "format": "table",
          "legendFormat": "__auto",
          "refId": "H"
        }
      ]
    },
