        {
          "expr": "avg(latency_${percentile}_ms{topic=~\"executionReport\\..*\\.TOTAL\", job=\"$app\"})",
          "legendFormat": "executionReport",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "OrderRequest \u2014 $percentile (ms)",
