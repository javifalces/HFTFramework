      "type": "timeseries",
      "title": "Order Request Latency by Stage (ms) \u2014 $percentile",
      "description": "Outbound: toAlgoConnector / toBrokerConnector / toStrategy / toNow for order requests",
      "gridPos": {"x": 12, "y": 22, "w": 12, "h": 7},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
