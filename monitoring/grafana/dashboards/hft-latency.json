{
  "uid": "hft-latency",
  "title": "HFT - Latency Statistics",
  "description": "Latency percentiles for depth, trade, executionReport, and orderRequest paths tracked by LatencyStatistics",
  "tags": [
    "hft",
    "latency"
  ],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 2,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {},
  "links": [],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "app",
        "label": "Application",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(latency_mean_ms, job)",
        "refresh": 2,
        "multi": false,
        "includeAll": false,
        "sort": 1,
        "hide": 0
      },
      {
        "name": "percentile",
        "label": "Percentile",
        "type": "custom",
        "query": "p50,p75,p90,p95,p99,max,mean",
        "current": {
          "selected": true,
          "text": "p90",
          "value": "p90"
        },
        "options": [
          {"selected": false, "text": "p50",  "value": "p50"},
          {"selected": false, "text": "p75",  "value": "p75"},
          {"selected": true,  "text": "p90",  "value": "p90"},
          {"selected": false, "text": "p95",  "value": "p95"},
          {"selected": false, "text": "p99",  "value": "p99"},
          {"selected": false, "text": "max",  "value": "max"},
          {"selected": false, "text": "mean", "value": "mean"}
        ],
        "hide": 0,
        "multi": false,
        "includeAll": false
      },
      {
        "name": "prefix",
        "label": "Prefix",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(latency_mean_ms{job=\"$app\"}, topic)",
        "regex": "/^([^.]+)\\..*/",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "sort": 1,
        "hide": 0
      },
      {
        "name": "topic",
        "label": "Topic",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(latency_mean_ms{job=\"$app\", topic=~\"($prefix)\\\\..*\"}, topic)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "sort": 1,
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Overview by Prefix \u2014 $percentile",
      "collapsed": false,
      "gridPos": {"x": 0, "y": 0, "w": 24, "h": 1}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Depth \u2014 $percentile (ms)",
      "description": "Total $percentile latency across all depth topics",
      "gridPos": {"x": 0, "y": 1, "w": 6, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green",  "value": null},
              {"color": "yellow", "value": 10},
              {"color": "red",    "value": 100}
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "avg(latency_${percentile}_ms{topic=~\"depth\\..*\\.TOTAL\", job=\"$app\"})",
          "legendFormat": "depth",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Trade \u2014 $percentile (ms)",
      "description": "Total $percentile latency across all trade topics",
      "gridPos": {"x": 6, "y": 1, "w": 6, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green",  "value": null},
              {"color": "yellow", "value": 10},
              {"color": "red",    "value": 100}
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "avg(latency_${percentile}_ms{topic=~\"trade\\..*\\.TOTAL\", job=\"$app\"})",
          "legendFormat": "trade",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "ExecutionReport \u2014 $percentile (ms)",
      "description": "Total $percentile latency across all executionReport topics",
