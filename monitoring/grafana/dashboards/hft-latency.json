              "Value #F": "p99 (ms)",
              "Value #G": "max (ms)",
              "Value #H": "count"
            }
          }
        }
      ],
      "targets": [
        {
          "expr": "latency_mean_ms{topic=~\"$topic\", job=\"$app\"}",
          "instant": true,
          "format": "table",
          "legendFormat": "__auto",
          "refId": "A"
        },
        {
          "expr": "latency_p50_ms{topic=~\"$topic\", job=\"$app\"}",
          "instant": true,
          "format": "table",
          "legendFormat": "__auto",
          "refId": "B"
        },
        {
          "expr": "latency_p75_ms{topic=~\"$topic\", job=\"$app\"}",
          "instant": true,
          "format": "table",
          "legendFormat": "__auto",
          "refId": "C"
        },
        {
          "expr": "latency_p90_ms{topic=~\"$topic\", job=\"$app\"}",
          "instant": true,
          "format": "table",
          "legendFormat": "__auto",
          "refId": "D"
        },
