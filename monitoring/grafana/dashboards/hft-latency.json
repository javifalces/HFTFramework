{
  "uid": "hft-latency",
  "title": "HFT - Latency Statistics",
  "description": "Latency percentiles for depth, trade, executionReport, and orderRequest paths tracked by LatencyStatistics",
  "tags": [
    "hft",
    "latency"
  ],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 3,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {},
  "links": [],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "app",
        "label": "Application",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(jvm_memory_bytes_used, job)",
        "refresh": 2,
        "multi": false,
        "includeAll": false,
        "sort": 1,
        "hide": 0
      },
      {
        "name": "percentile",
        "label": "Percentile",
        "type": "custom",
        "query": "p50,p75,p90,p95,p99,max,mean",
        "current": {
          "selected": true,
          "text": "p90",
          "value": "p90"
        },
        "options": [
          {"selected": false, "text": "p50",  "value": "p50"},
          {"selected": false, "text": "p75",  "value": "p75"},
          {"selected": true,  "text": "p90",  "value": "p90"},
          {"selected": false, "text": "p95",  "value": "p95"},
          {"selected": false, "text": "p99",  "value": "p99"},
          {"selected": false, "text": "max",  "value": "max"},
          {"selected": false, "text": "mean", "value": "mean"}
        ],
        "hide": 0,
        "multi": false,
        "includeAll": false
      },
      {
        "name": "prefix",
        "label": "Prefix",
        "type": "custom",
        "query": "depth,trade,executionReport,orderRequest",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": [
          {"selected": true,  "text": "All",              "value": "$__all"},
          {"selected": false, "text": "depth",             "value": "depth"},
          {"selected": false, "text": "trade",             "value": "trade"},
          {"selected": false, "text": "executionReport",   "value": "executionReport"},
          {"selected": false, "text": "orderRequest",      "value": "orderRequest"}
        ],
        "hide": 0,
        "multi": false,
        "includeAll": true,
        "allValue": ".*"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Overview \u2014 $percentile (last value per prefix)",
      "collapsed": false,
      "gridPos": {"x": 0, "y": 0, "w": 24, "h": 1}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Depth \u2014 $percentile (ms)",
      "description": "Last $percentile latency for the depth prefix (TOTAL across all topics)",
      "gridPos": {"x": 0, "y": 1, "w": 6, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green",  "value": null},
              {"color": "yellow", "value": 10},
              {"color": "red",    "value": 100}
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "avg({job=\"$app\", __name__=\"latency_${percentile}_ms\", topic=~\"depth.*TOTAL\"})",
          "legendFormat": "depth",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Trade \u2014 $percentile (ms)",
      "description": "Last $percentile latency for the trade prefix (TOTAL across all topics)",
      "gridPos": {"x": 6, "y": 1, "w": 6, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green",  "value": null},
              {"color": "yellow", "value": 10},
              {"color": "red",    "value": 100}
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "avg({job=\"$app\", __name__=\"latency_${percentile}_ms\", topic=~\"trade.*TOTAL\"})",
          "legendFormat": "trade",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "ExecutionReport \u2014 $percentile (ms)",
      "description": "Last $percentile latency for the executionReport prefix (TOTAL across all topics)",
      "gridPos": {"x": 12, "y": 1, "w": 6, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green",  "value": null},
              {"color": "yellow", "value": 10},
              {"color": "red",    "value": 100}
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "avg({job=\"$app\", __name__=\"latency_${percentile}_ms\", topic=~\"executionReport.*TOTAL\"})",
          "legendFormat": "executionReport",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "OrderRequest \u2014 $percentile (ms)",
      "description": "Last $percentile latency for the orderRequest prefix (TOTAL across all topics)",
      "gridPos": {"x": 18, "y": 1, "w": 6, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green",  "value": null},
              {"color": "yellow", "value": 10},
              {"color": "red",    "value": 100}
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "avg({job=\"$app\", __name__=\"latency_${percentile}_ms\", topic=~\"orderRequest.*TOTAL\"})",
          "legendFormat": "orderRequest",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "type": "row",
      "title": "Latency by Stage \u2014 $prefix \u2014 $percentile",
      "collapsed": false,
      "gridPos": {"x": 0, "y": 5, "w": 24, "h": 1}
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "TOTAL \u2014 $percentile (ms)",
      "description": "End-to-end total latency over time for the selected prefix",
      "gridPos": {"x": 0, "y": 6, "w": 24, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "options": {
        "tooltip": {"mode": "multi"},
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max", "mean"]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {"lineWidth": 2}
        }
      },
      "targets": [
        {
          "expr": "{job=\"$app\", __name__=\"latency_${percentile}_ms\", topic=~\"$prefix.*TOTAL\"}",
          "legendFormat": "{{topic}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "toBrokerConnector \u2014 $percentile (ms)",
      "description": "Latency from market timestamp to broker connector for the selected prefix",
      "gridPos": {"x": 0, "y": 14, "w": 12, "h": 7},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "options": {
        "tooltip": {"mode": "multi"},
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max", "mean"]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {"lineWidth": 2}
        }
      },
      "targets": [
        {
          "expr": "{job=\"$app\", __name__=\"latency_${percentile}_ms\", topic=~\"$prefix.*toBrokerConnector\"}",
          "legendFormat": "{{topic}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "toAlgoConnector \u2014 $percentile (ms)",
      "description": "Latency from broker connector to algo connector for the selected prefix",
      "gridPos": {"x": 12, "y": 14, "w": 12, "h": 7},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "options": {
        "tooltip": {"mode": "multi"},
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max", "mean"]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {"lineWidth": 2}
        }
      },
      "targets": [
        {
          "expr": "{job=\"$app\", __name__=\"latency_${percentile}_ms\", topic=~\"$prefix.*toAlgoConnector\"}",
          "legendFormat": "{{topic}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "toStrategy \u2014 $percentile (ms)",
      "description": "Latency from algo connector to strategy for the selected prefix",
      "gridPos": {"x": 0, "y": 21, "w": 12, "h": 7},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "options": {
        "tooltip": {"mode": "multi"},
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max", "mean"]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {"lineWidth": 2}
        }
      },
      "targets": [
        {
          "expr": "{job=\"$app\", __name__=\"latency_${percentile}_ms\", topic=~\"$prefix.*toStrategy\"}",
          "legendFormat": "{{topic}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "toNow \u2014 $percentile (ms)",
      "description": "Latency from last stage to current time (processing lag) for the selected prefix",
      "gridPos": {"x": 12, "y": 21, "w": 12, "h": 7},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "options": {
        "tooltip": {"mode": "multi"},
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max", "mean"]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {"lineWidth": 2}
        }
      },
      "targets": [
        {
          "expr": "{job=\"$app\", __name__=\"latency_${percentile}_ms\", topic=~\"$prefix.*toNow\"}",
          "legendFormat": "{{topic}}",
          "refId": "A"
        }
      ]
    }
  ]
}