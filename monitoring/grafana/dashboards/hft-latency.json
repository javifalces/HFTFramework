    {
      "id": 10,
      "type": "row",
      "title": "Latency by Topic Over Time",
      "collapsed": false,
      "gridPos": {"x": 0, "y": 5, "w": 24, "h": 1}
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "$percentile Latency by Topic \u2014 TOTAL (ms)",
      "description": "Per-topic TOTAL latency over time. Use the Prefix variable to filter by message type and the Topic variable for finer selection.",
      "gridPos": {"x": 0, "y": 6, "w": 24, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "options": {
        "tooltip": {"mode": "multi"},
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max", "mean"]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {"lineWidth": 2}
        }
      },
      "targets": [
        {
          "expr": "latency_${percentile}_ms{topic=~\"$topic\", job=\"$app\"}",
          "legendFormat": "{{topic}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Max Latency Over Time (ms)",
      "gridPos": {"x": 0, "y": 14, "w": 12, "h": 7},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "options": {
        "tooltip": {"mode": "multi"},
        "legend": {"displayMode": "list", "placement": "bottom"}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {"lineWidth": 2}
        }
      },
      "targets": [
        {
          "expr": "latency_max_ms{topic=~\"$topic\", job=\"$app\"}",
          "legendFormat": "max \u2014 {{topic}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Mean Latency Over Time (ms)",
      "gridPos": {"x": 12, "y": 14, "w": 12, "h": 7},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "options": {
        "tooltip": {"mode": "multi"},
        "legend": {"displayMode": "list", "placement": "bottom"}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {"lineWidth": 2}
        }
      },
      "targets": [
        {
          "expr": "latency_mean_ms{topic=~\"$topic\", job=\"$app\"}",
          "legendFormat": "mean \u2014 {{topic}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 20,
      "type": "row",
      "title": "Latency by Stage",
      "collapsed": false,
      "gridPos": {"x": 0, "y": 21, "w": 24, "h": 1}
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Depth Latency by Stage (ms) \u2014 $percentile",
      "description": "toBrokerConnector / toAlgoConnector / toStrategy / toNow latencies for depth updates",
      "gridPos": {"x": 0, "y": 22, "w": 12, "h": 7},
