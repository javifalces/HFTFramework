<?xml version="1.0" encoding="UTF-8"?>
<configuration monitorInterval="60" status="OFF" packages="com.lambda.investing">
    <properties>
        <!-- time-stamp unique to execution instance -->
        <property name="timestamp">${date:yyMMdd_HHmmss}</property>
        <property name="log.appName">MetatraderEngine</property>
        <property name="log.path">$${env:LAMBDA_LOGS_PATH}/${date:yyMMdd}</property>
        <!-- max number of files -->
        <property name="numFiles">100</property>
        <property name="log.fileSize">500 MB</property>
    </properties>

    <appenders>
        <Console name="console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} %-5p [%t] %c{1} - %m%n" charset="UTF-8"/>
        </Console>

        <RollingFile name="file" fileName="${sys:log.path}/${sys:log.appName}_${timestamp}.log"
                     filePattern="${sys:log.path}/${sys:log.appName}_${timestamp}.log.%d{yyMMdd_HHmmss}">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} %-5p [%t] %c{1} - %m%n" charset="UTF-8"/>

            <Policies>
                <SizeBasedTriggeringPolicy size="${sys:log.fileSize}"/>
            </Policies>
            <DefaultRolloverStrategy max="${numFiles}"/>

        </RollingFile>

        <RollingFile name="fileStatistics"
                     fileName="${sys:log.path}/${sys:log.appName:-MetatraderEngine}_${timestamp}_statistics.log"
                     filePattern="${sys:log.path}/${sys:log.appName:-MetatraderEngine}_${timestamp}_statistics.log.%d{yyMMdd_HHmmss}">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} %-5p [%t] %c{1} - %m%n" charset="UTF-8"/>

            <Policies>
                <SizeBasedTriggeringPolicy size="${sys:log.fileSize}"/>
            </Policies>
            <DefaultRolloverStrategy max="${numFiles}"/>
        </RollingFile>

        <!-- Optional Loki appender: active when LOKI_HOST env var is set; no-op otherwise -->
        <LokiAppender name="loki"
                      host="${env:LOKI_HOST:-}"
                      port="${env:LOKI_PORT:-3100}"
                      appName="${sys:log.appName:-hft-framework}"/>

    </appenders>

    <loggers>


        <!--Console info output-->
        <root level="INFO">
            <appender-ref ref="console"/>
            <appender-ref ref="file"/>
            <appender-ref ref="loki"/>
        </root>

        <AsyncLogger name="com.lambda.investing.LatencyStatistics" level="info" additivity="false">
            <AppenderRef ref="fileStatistics"/>
            <AppenderRef ref="loki"/>
        </AsyncLogger>
        <AsyncLogger name="com.lambda.investing.trading_engine_connector.SlippageStatistics" level="info"
                     additivity="false">
            <AppenderRef ref="fileStatistics"/>
            <AppenderRef ref="loki"/>
        </AsyncLogger>
        <AsyncLogger name="com.lambda.investing.Statistics" level="info" additivity="false">
            <AppenderRef ref="fileStatistics"/>
            <AppenderRef ref="loki"/>
        </AsyncLogger>

    </loggers>
</configuration>