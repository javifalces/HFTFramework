<?xml version="1.0" encoding="UTF-8"?>
<configuration monitorInterval="60" status="OFF">
    <properties>
        <!-- time-stamp unique to execution instance -->
        <property name="timestamp">${date:yyMMdd_HHmmss}</property>
        <property name="timestampDay">${date:yyMMdd}</property>
        <property name="log.path">$${env:LAMBDA_LOGS_PATH}/${date:yyMMdd}</property>
        <!-- max number of files -->
        <property name="numFiles">100</property>
        <property name="log.fileSize">500 MB</property>
    </properties>

    <appenders>
        <Console name="console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} %-5p [%t] %c{1} - %m%n" charset="UTF-8"/>
        </Console>

        <RollingFile name="file" fileName="${sys:log.path}/${sys:log.appName:-AlgoTradingZeroMQ}_${timestamp}.log"
                     filePattern="${sys:log.path}/${sys:log.appName:-AlgoTradingZeroMQ}_${timestamp}.log.%d{yyMMdd_HHmmss}">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} %-5p [%t] %c{1} - %m%n" charset="UTF-8"/>

            <Policies>
                <SizeBasedTriggeringPolicy size="${sys:log.fileSize}"/>
            </Policies>
            <DefaultRolloverStrategy max="${numFiles}"/>
        </RollingFile>

        <RollingFile name="fileStatistics"
                     fileName="${sys:log.path}/${sys:log.appName:-AlgoTradingZeroMQ}_${timestamp}_statistics.log"
                     filePattern="${sys:log.path}/${sys:log.appName:-AlgoTradingZeroMQ}_${timestamp}_statistics.log.%d{yyMMdd_HHmmss}">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} %-5p [%t] %c{1} - %m%n" charset="UTF-8"/>

            <Policies>
                <SizeBasedTriggeringPolicy size="${sys:log.fileSize}"/>
            </Policies>
            <DefaultRolloverStrategy max="${numFiles}"/>
        </RollingFile>

        <RollingFile name="tradeReport"
                     fileName="${sys:log.path}/${sys:log.appName:-AlgoTradingZeroMQ}_trades_${timestampDay}.csv"
                     filePattern="${sys:log.path}/${sys:log.appName:-AlgoTradingZeroMQ}_trades_${timestampDay}.csv.%i"
                     append="true">
            <PatternLayout pattern="%m%n" charset="UTF-8"/>
            <Policies>
                <SizeBasedTriggeringPolicy size="5 GB"/>
            </Policies>
            <DefaultRolloverStrategy max="${numFiles}"/>

        </RollingFile>


    </appenders>

    <loggers>


        <AsyncLogger name="com.lambda.investing.data_manager" level="debug">
            <AppenderRef ref="file"/>
        </AsyncLogger>

        <!--Console info output-->
        <root level="WARN">
            <appender-ref ref="console"/>
        </root>

        <AsyncLogger name="com.lambda" level="INFO" additivity="false">
            <appender-ref ref="file"/>
        </AsyncLogger>

        <!--Configure LatencyStatistics logs and Statistics logs into fileStatistics info level-->
        <AsyncLogger name="com.lambda.investing.LatencyStatistics" level="info" additivity="false">
            <AppenderRef ref="fileStatistics"/>
        </AsyncLogger>
        <AsyncLogger name="com.lambda.investing.trading_engine_connector.SlippageStatistics" level="info"
                     additivity="false">
            <AppenderRef ref="fileStatistics"/>
        </AsyncLogger>
        <AsyncLogger name="com.lambda.investing.Statistics" level="info" additivity="false">
            <AppenderRef ref="fileStatistics"/>
        </AsyncLogger>

        <!--Configure TradeReport logs into tradeReport CSV file-->
        <AsyncLogger name="com.lambda.investing.algorithmic_trading.observer.LiveTradeReport" level="info"
                     additivity="false">
            <AppenderRef ref="tradeReport"/>
        </AsyncLogger>


    </loggers>
</configuration>